<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <RootNamespace>CaldovaSuper.App</RootNamespace>
    <AssemblyName>be-pay-check</AssemblyName>
    <NoWarn>$(NoWarn);OPENAI001;SCME0001</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <EnableDefaultRazorComponentItems>false</EnableDefaultRazorComponentItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\agent\cs-agent.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Azure.AI.Extensions.OpenAI" Version="2.0.0" />
    <PackageReference Include="Azure.AI.Projects" Version="2.0.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.2.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" /><Compile Include="..\src\backend\Api\PaymentsApi.cs" Link="Api\PaymentsApi.cs" />
    <Compile Include="..\src\backend\Api\AgentSseStreaming.cs" Link="Api\AgentSseStreaming.cs" />
    <Compile Include="..\src\backend\Mcp\PaymentsMcpTools.cs" Link="Mcp\PaymentsMcpTools.cs" />
    <Compile Include="..\src\backend\Mcp\TeamsMcpTools.cs" Link="Mcp\TeamsMcpTools.cs" />
    <Compile Include="..\src\backend\Services\PaymentApprovalStore.cs" Link="Services\PaymentApprovalStore.cs" />
    <Compile Include="..\src\backend\Services\CaseStore.cs" Link="Services\CaseStore.cs" />
    <Compile Include="..\src\backend\Services\CaldovaAgentFactory.cs" Link="Services\CaldovaAgentFactory.cs" />
    <Compile Include="..\src\backend\Services\CaldovaAgentOptions.cs" Link="Services\CaldovaAgentOptions.cs" />
    <Compile Include="..\src\backend\Models\RequestSamples.cs" Link="Models\RequestSamples.cs" />
  </ItemGroup>
</Project>
