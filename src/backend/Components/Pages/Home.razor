@page "/"

<PageTitle>Wealth Team in a Day — Caldova Wealth</PageTitle>

<div class="hero">
    <div class="hero-inner">
        <div class="eyebrow">
            <span class="eyebrow-dot"></span>
            Caldova Wealth · Client Operations · Melbourne
        </div>
        <div class="trust-strip" aria-label="Platform assurances">
            <span class="trust-pill">🔒 Encrypted</span>
            <span class="trust-pill">🧾 Fully audited</span>
            <span class="trust-pill">👤 Human-approved</span>
        </div>
        <h1>An AI operations team your advisers and members can <span class="hl">trust</span>.</h1>
        <p class="lead">
            A coordinated team of specialised Microsoft Foundry agents supporting the people who run
            Caldova's super, pension and investment platform — onboarding, benefits and eligibility,
            investment solutions, financial crime, transfers and rollovers, payments and client
            communications, with a team leader watching the whole floor. Agents check, calculate,
            draft and recommend; humans approve. Open any card to see the agent work a real case.
        </p>
        <div class="hero-meta" aria-label="Demo at a glance">
            <div class="hero-stat"><span class="hero-stat-num">8</span><span class="hero-stat-label">Specialist agents</span></div>
            <div class="hero-stat"><span class="hero-stat-num">5</span><span class="hero-stat-label">Live member cases</span></div>
            <div class="hero-stat"><span class="hero-stat-num">100%</span><span class="hero-stat-label">Payments human-approved</span></div>
            <div class="hero-stat"><span class="hero-stat-num">0</span><span class="hero-stat-label">Personal advice given</span></div>
        </div>
        <div class="scenarios-line">
            <strong>Scenarios</strong>
            @foreach (var scenario in ScenarioCatalog.All)
            {
                <a class="chip" href="@($"/scenarios/{scenario.Id}")">@scenario.Icon @scenario.ShortTitle</a>
            }
        </div>
    </div>
    <svg class="hero-chart" viewBox="0 0 800 200" preserveAspectRatio="none" aria-hidden="true">
        <defs>
            <linearGradient id="hc-fill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#2dd4bf" stop-opacity="0.28" />
                <stop offset="1" stop-color="#2dd4bf" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="hc-line" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#3b82f6" />
                <stop offset="1" stop-color="#2dd4bf" />
            </linearGradient>
        </defs>
        <path d="M0 160 C 60 150, 100 170, 160 140 S 260 120, 320 110 S 430 130, 490 90 S 600 70, 660 50 S 760 40, 800 20 L800 200 L0 200 Z" fill="url(#hc-fill)" />
        <path d="M0 160 C 60 150, 100 170, 160 140 S 260 120, 320 110 S 430 130, 490 90 S 600 70, 660 50 S 760 40, 800 20" fill="none" stroke="url(#hc-line)" stroke-width="2" vector-effect="non-scaling-stroke" />
    </svg>
    <div class="hero-glow" aria-hidden="true"></div>
</div>

<div class="section-label">The operations office</div>

<div class="agent-grid">
    @foreach (var agent in AgentCatalog.All)
    {
        <a class="agent-card" href="@($"/agents/{agent.Id}")" style="--accent: @agent.Accent">
            <div class="agent-card-icon" aria-hidden="true">@agent.Icon</div>
            <div class="agent-card-body">
                <div class="agent-card-dept">@agent.Department</div>
                <h2>@agent.Name</h2>
                <div class="agent-card-persona">@agent.Persona</div>
                <p>@agent.Tagline</p>
                <div class="agent-card-cta">View agent →</div>
            </div>
        </a>
    }
</div>

<style>
    .hero {
        position: relative;
        overflow: hidden;
        background:
            radial-gradient(ellipse 50% 70% at 88% 0%, rgba(45, 212, 191, 0.20), transparent 70%),
            radial-gradient(ellipse 45% 60% at 0% 100%, rgba(59, 130, 246, 0.16), transparent 70%),
            linear-gradient(135deg, #07142a 0%, #0a1c36 55%, #08172d 100%);
        color: #fff;
        padding: 2.8rem 2.4rem 3.4rem 2.4rem;
        border: 1px solid rgba(130, 165, 210, 0.2);
        border-radius: 20px;
        margin-bottom: 1.9rem;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07), 0 24px 60px -24px rgba(0, 0, 0, 0.8);
    }
    .hero::before {
        content: "";
        position: absolute;
        inset: 0 0 auto 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, #2dd4bf 30%, #3b82f6 70%, transparent);
        opacity: 0.85;
    }
    .hero-inner { position: relative; z-index: 1; }

    .hero-chart {
        position: absolute;
        left: 0; right: 0; bottom: 0;
        width: 100%;
        height: 46%;
        opacity: 0.55;
        pointer-events: none;
    }

    .hero-glow {
        position: absolute;
        right: -120px;
        top: -140px;
        width: 420px;
        height: 420px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(45, 212, 191, 0.2) 0%, transparent 65%);
        pointer-events: none;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: #a7f3e4;
        margin: 0 0.9rem 0.9rem 0;
        font-weight: 600;
    }
    .eyebrow-dot {
        width: 8px; height: 8px; border-radius: 50%;
        background: #2dd4bf;
        box-shadow: 0 0 0 4px rgba(45, 212, 191, 0.18), 0 0 14px rgba(45, 212, 191, 0.7);
    }

    .trust-strip { display: inline-flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.9rem; vertical-align: top; }
    .trust-pill {
        font-size: 0.68rem;
        letter-spacing: 0.06em;
        color: var(--cw-gold, #e3c47e);
        background: rgba(227, 196, 126, 0.07);
        border: 1px solid rgba(227, 196, 126, 0.28);
        padding: 0.18rem 0.6rem;
        border-radius: 999px;
        font-weight: 600;
    }

    .hero h1 {
        margin: 0 0 0.75rem 0;
        font-size: 2.3rem;
        line-height: 1.14;
        font-weight: 650;
        letter-spacing: -0.025em;
        color: #fff;
        max-width: 40rem;
    }
    .hero h1 .hl {
        color: #2dd4bf;
        background: linear-gradient(135deg, #5eead4, #60a5fa);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero .lead {
        font-size: 1rem;
        line-height: 1.6;
        max-width: 56rem;
        color: rgba(226, 236, 250, 0.82);
        margin: 0;
    }

    .hero-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.7rem;
        margin: 1.4rem 0 1.1rem 0;
    }
    .hero-stat {
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
        border: 1px solid rgba(130, 165, 210, 0.22);
        border-radius: 12px;
        padding: 0.65rem 1rem;
        backdrop-filter: blur(8px);
        min-width: 8rem;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }
    .hero-stat-num {
        display: block;
        font-size: 1.6rem;
        font-weight: 650;
        color: #fff;
        line-height: 1.1;
        letter-spacing: -0.02em;
        font-variant-numeric: tabular-nums;
    }
    .hero-stat-label {
        display: block;
        font-size: 0.64rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: rgba(167, 243, 228, 0.7);
        margin-top: 3px;
    }

    .scenarios-line {
        margin-top: 0.6rem;
        font-size: 0.92rem;
        color: rgba(226, 236, 250, 0.78);
    }
    .scenarios-line strong { color: #fff; margin-right: 0.4rem; }
    .chip {
        display: inline-block;
        background: rgba(125, 211, 252, 0.08);
        border: 1px solid rgba(125, 211, 252, 0.26);
        color: #d6f1ff;
        padding: 0.22rem 0.75rem;
        border-radius: 999px;
        margin-right: 0.4rem;
        font-size: 0.82rem;
    }
    a.chip { text-decoration: none; margin-bottom: 0.4rem; transition: background 0.15s ease, border-color 0.15s ease; }
    a.chip:hover { background: rgba(45, 212, 191, 0.16); border-color: rgba(45, 212, 191, 0.55); color: #fff; }

    .section-label {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: var(--cw-muted, #93a3bb);
        font-weight: 600;
        margin: 0 0 0.8rem 0.15rem;
    }
    .section-label::after {
        content: "";
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, rgba(130, 165, 210, 0.3), transparent);
    }

    .agent-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
        gap: 1.1rem;
    }

    .agent-card {
        position: relative;
        display: flex;
        gap: 0.9rem;
        align-items: flex-start;
        background:
            linear-gradient(180deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0) 40%),
            rgba(14, 22, 38, 0.8);
        border: 1px solid rgba(130, 165, 210, 0.16);
        border-radius: 16px;
        padding: 1.1rem 1.15rem 1.05rem 1.15rem;
        text-decoration: none;
        color: inherit;
        backdrop-filter: blur(8px);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease, background 0.18s ease;
        overflow: hidden;
    }
    .agent-card::before {
        content: "";
        position: absolute;
        left: 0; top: 0; right: 0;
        height: 2px;
        background: linear-gradient(90deg, var(--accent, #2dd4bf), transparent 75%);
        opacity: 0.9;
    }
    .agent-card::after {
        content: "";
        position: absolute;
        right: -40px; top: -40px;
        width: 160px; height: 160px;
        border-radius: 50%;
        background: radial-gradient(circle, color-mix(in srgb, var(--accent, #2dd4bf) 22%, transparent) 0%, transparent 70%);
        pointer-events: none;
        opacity: 0.55;
    }
    .agent-card:hover {
        transform: translateY(-4px);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07), 0 18px 40px -16px color-mix(in srgb, var(--accent, #2dd4bf) 45%, rgba(0, 0, 0, 0.8));
        border-color: color-mix(in srgb, var(--accent, #2dd4bf) 50%, rgba(130, 165, 210, 0.16));
    }
    .agent-card:hover { text-decoration: none; }

    .agent-card-icon {
        font-size: 1.6rem;
        line-height: 1;
        flex: 0 0 auto;
        width: 46px;
        height: 46px;
        border-radius: 12px;
        background: color-mix(in srgb, var(--accent, #2dd4bf) 16%, rgba(14, 22, 38, 0.6));
        border: 1px solid color-mix(in srgb, var(--accent, #2dd4bf) 40%, transparent);
        display: grid;
        place-items: center;
        position: relative;
        z-index: 1;
    }

    .agent-card-body { min-width: 0; flex: 1; position: relative; z-index: 1; }
    .agent-card-body h2 {
        font-size: 1.05rem;
        margin: 0.15rem 0 0.2rem 0;
        color: #fff;
        font-weight: 650;
        letter-spacing: -0.01em;
    }
    .agent-card-dept {
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--accent, #2dd4bf);
        font-weight: 700;
    }
    .agent-card-persona {
        font-size: 0.8rem;
        color: rgba(200, 216, 238, 0.7);
        margin-bottom: 0.4rem;
    }
    .agent-card p {
        margin: 0;
        font-size: 0.9rem;
        color: rgba(226, 236, 250, 0.8);
        line-height: 1.5;
    }
    .agent-card-cta {
        margin-top: 0.7rem;
        font-size: 0.78rem;
        color: var(--accent, #2dd4bf);
        font-weight: 600;
        letter-spacing: 0.3px;
        opacity: 0.85;
        transition: transform 0.15s ease, opacity 0.15s ease;
    }
    .agent-card:hover .agent-card-cta {
        opacity: 1;
        transform: translateX(3px);
    }

    @@media (max-width: 640px) {
        .hero { padding: 1.75rem 1.25rem 2.6rem 1.25rem; }
        .hero h1 { font-size: 1.6rem; }
    }
</style>
