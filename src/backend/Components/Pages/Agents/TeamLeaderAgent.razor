@page "/agents/team-leader"

<PageTitle>Team Leader Agent — Wealth Team in a Day</PageTitle>

<div class="agent-header" style="--accent: #14b8a6">
    <a class="back-link" href="/"><span aria-hidden="true">←</span> Back to the operations office</a>
    <div class="agent-header-row">
        <div class="agent-header-icon">🧭</div>
        <div>
            <div class="agent-header-dept">Team Leader Office</div>
            <h1>Team Leader Agent</h1>
            <div class="agent-header-persona">Theo — Client Operations Team Leader</div>
            <p class="tagline">Watches the whole floor — SLAs, IDR clocks and approvals.</p>
        </div>
    </div>
</div>

<div class="agent-tab-scope" style="--accent: #14b8a6">
    <nav class="agent-tabs" role="tablist" aria-label="Team Leader demos">
        <button type="button" class="agent-tab active" data-tab="try" role="tab" aria-selected="true" tabindex="0">Try it out</button>
        <button type="button" class="agent-tab" data-tab="groupchat" role="tab" aria-selected="false" tabindex="-1">Group Chat</button>
    </nav>

    <div class="agent-tab-panel active" data-panel="try" role="tabpanel">
    <section class="panel leader-panel" style="--accent: #14b8a6">
        <!-- Step 1 — pick a case -->
        <div class="leader-step" data-step="1">
            <div class="leader-step-head">
                <span class="leader-step-num">1</span>
                <h3>Pick a case</h3>
            </div>
            <p class="muted">The case you pick becomes Theo's focus.</p>
            <div class="leader-case-row">
                <select id="leader-case-select" aria-label="Member Case">
                    <option value="">— Select a case —</option>
                </select>
                <button type="button" id="leader-refresh-btn" class="leader-secondary"
                        title="Reload the list of cases">↻ Refresh</button>
            </div>
            <p class="muted leader-empty" id="leader-empty" hidden>
                No cases yet. Open one with the
                <a href="/agents/onboarding">Onboarding Agent</a>, then come back here.
            </p>
            <div class="leader-case-card" id="leader-case-card" hidden>
                <div class="leader-case-num" id="leader-case-num"></div>
                <div class="leader-case-grid">
                    <div><span class="k">Client</span><span id="leader-case-client"></span></div>
                    <div><span class="k">Member no.</span><span id="leader-case-member"></span></div>
                    <div><span class="k">Request type</span><span id="leader-case-type"></span></div>
                    <div><span class="k">Received</span><span id="leader-case-received"></span></div>
                    <div><span class="k">Adviser</span><span id="leader-case-adviser"></span></div>
                    <div><span class="k">Amount</span><span id="leader-case-amount"></span></div>
                    <div class="span-2"><span class="k">Priority</span><span id="leader-case-priority"></span></div>
                    <div class="span-2"><span class="k">Request</span><span id="leader-case-request"></span></div>
                </div>
            </div>
        </div>

        <!-- Step 2 — engage the agent -->
        <div class="leader-step" data-step="2" id="leader-step-2" hidden>
            <div class="leader-step-head">
                <span class="leader-step-num">2</span>
                <h3>Engage Team Leader Agent</h3>
            </div>
            <button id="leader-process-btn" type="button" disabled>Review the floor with Theo</button>
            <div id="leader-process-status" class="leader-status" hidden></div>

            <div class="engage-tabs-scope" data-engage-role="team-leader">
                <div class="engage-tabs" role="tablist">
                    <button type="button" class="engage-tab-btn active" data-engage-tab="narrative">Agent Narrative</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="reference">Reference</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="prompt">Agent Prompt &amp; Tools</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="input">Agent Input</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="output">Raw Output</button>
                </div>

                <div class="engage-tab-panel active" data-engage-tab="narrative">
                    <div class="engage-info-block">
                        <h4>Agent narrative (streamed)</h4>
                        <div class="agent-md engage-narrative-body"><div class="engage-empty">Engage the agent to see the streamed narrative.</div></div>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="reference">
                    <div class="engage-info-block">
                        <h4>Reference documents cited by the agent</h4>
                        <div class="engage-references-body"><div class="engage-empty">Engage the agent to see the reference documents cited in its response.</div></div>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="prompt">
                    <div class="engage-info-block">
                        <h4>Agent metadata</h4>
                        <div class="engage-info-meta engage-meta"></div>
                    </div>
                    <div class="engage-info-block">
                        <h4>System prompt</h4>
                        <pre class="engage-pre engage-prompt-body">Loading…</pre>
                    </div>
                    <div class="engage-info-block">
                        <h4>Tools available</h4>
                        <ul class="engage-tools-list"><li class="engage-empty">Loading…</li></ul>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="input">
                    <div class="engage-info-block">
                        <h4>Prompt sent to the agent</h4>
                        <pre class="engage-pre engage-input-body engage-empty">Engage the agent to capture the input that was sent.</pre>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="output">
                    <div class="engage-info-block">
                        <h4>Raw agent output (text, citations, every output item including tool / function calls)</h4>
                        <div class="json-viewer engage-output-body"><div class="engage-empty">Engage the agent to see the full raw response.</div></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Step 3 — floor dashboard -->
        <div class="leader-step" data-step="3" id="leader-results" hidden>
            <div class="leader-step-head">
                <span class="leader-step-num">3</span>
                <h3>Floor dashboard</h3>
            </div>
            <p class="muted tl-asat-line" id="leader-asat"></p>

            <div class="tl-focus" id="leader-focus"></div>

            <div class="tl-section">
                <h4>Cases by stage</h4>
                <div class="tl-tiles" id="leader-stage-tiles"></div>
            </div>

            <div class="tl-section">
                <h4>SLA &amp; complaint clocks</h4>
                <div class="tl-table-wrap">
                    <table class="tl-table">
                        <thead><tr><th>Clock</th><th>Case</th><th>Rule</th><th>Status</th></tr></thead>
                        <tbody id="leader-clocks-body"></tbody>
                    </table>
                </div>
            </div>

            <div class="tl-section">
                <h4>Escalations</h4>
                <ul class="tl-escalations" id="leader-escalations"></ul>
            </div>

            <div class="tl-section">
                <h4>Approval queue — waiting on Theo</h4>
                <div class="tl-table-wrap">
                    <table class="tl-table">
                        <thead><tr><th>#</th><th>Case</th><th>Approval</th><th>Why it needs a human</th><th>Recommendation</th><th>Due</th></tr></thead>
                        <tbody id="leader-approvals-body"></tbody>
                    </table>
                </div>
                <p class="muted tl-note">Theo's agent recommends; Theo decides. Payment approvals are actioned in Microsoft Teams.</p>
            </div>

            <div class="tl-grid-2">
                <div class="tl-section">
                    <h4>Vulnerable members</h4>
                    <ul class="tl-list" id="leader-vulnerable"></ul>
                </div>
                <div class="tl-section">
                    <h4>Quality &amp; coaching insights</h4>
                    <ul class="tl-list" id="leader-coaching"></ul>
                </div>
            </div>

            <div class="tl-section">
                <h4>Recommended priorities for today</h4>
                <ol class="tl-priorities" id="leader-priorities"></ol>
            </div>
        </div>

    </section>
    </div>

    <div class="agent-tab-panel" data-panel="groupchat" role="tabpanel">
    <section class="panel groupchat-panel" style="--accent: #14b8a6">
        <!-- Step 1 — pick a case for the group chat -->
        <div class="leader-step" data-step="1">
            <div class="leader-step-head">
                <span class="leader-step-num">1</span>
                <h3>Pick a case</h3>
            </div>
            <p class="muted">Theo and the seven specialists discuss it together.</p>
            <div class="leader-case-row">
                <select id="gc-case-select" aria-label="Member Case">
                    <option value="">— Select a case —</option>
                </select>
                <button type="button" id="gc-refresh-btn" class="leader-secondary"
                        title="Reload the list of cases">↻ Refresh</button>
            </div>
            <p class="muted leader-empty" id="gc-empty" hidden>
                No cases yet. Open one with the
                <a href="/agents/onboarding">Onboarding Agent</a>, then come back here.
            </p>
            <div class="leader-case-card" id="gc-case-card" hidden>
                <div class="leader-case-num" id="gc-case-num"></div>
                <div class="leader-case-grid">
                    <div><span class="k">Client</span><span id="gc-case-client"></span></div>
                    <div><span class="k">Request type</span><span id="gc-case-type"></span></div>
                    <div><span class="k">Received</span><span id="gc-case-received"></span></div>
                    <div><span class="k">Priority</span><span id="gc-case-priority"></span></div>
                    <div class="span-2"><span class="k">Request</span><span id="gc-case-request"></span></div>
                </div>
            </div>
        </div>

        <!-- Step 2 — start the group chat -->
        <div class="leader-step" data-step="2" id="gc-step-2" hidden>
            <div class="leader-step-head">
                <span class="leader-step-num">2</span>
                <h3>Start the group chat</h3>
            </div>
            <p class="muted">Theo asks one specialist at a time, then closes with a plan.</p>

            <div class="gc-roster" id="gc-roster" aria-label="Participants"></div>

            <button id="gc-start-btn" type="button" disabled>Start group chat</button>
            <div id="gc-status" class="leader-status" hidden></div>
        </div>

        <!-- Step 3 — live transcript -->
        <div class="leader-step gc-transcript-step" data-step="3" id="gc-transcript-step" hidden>
            <div class="leader-step-head">
                <span class="leader-step-num">3</span>
                <h3>Live transcript</h3>
                <span class="tl-asat" id="gc-mode"></span>
            </div>
            <div id="gc-transcript" class="gc-transcript" aria-live="polite"></div>
        </div>
    </section>
    </div>
</div>

<style>
    .leader-panel { --leader-accent: #14b8a6; }
    .leader-panel a, .groupchat-panel a { color: color-mix(in srgb, var(--leader-accent) 60%, #0b1f3a); }

    .leader-step {
        border: 1px solid rgba(16, 38, 72, 0.112);
        background: #f9fafb;
        border-radius: 12px;
        padding: 0.95rem 1.1rem 1rem 1.1rem;
        margin-top: 0.9rem;
    }

    .leader-step-head { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.3rem; }
    .leader-step-head h3 { margin: 0; color: #0b1f3a; font-size: 1rem; }
    .leader-step-num {
        display: inline-grid; place-items: center;
        width: 1.55rem; height: 1.55rem;
        border-radius: 50%;
        background: color-mix(in srgb, var(--leader-accent) 22%, #f6f7f9);
        border: 1px solid color-mix(in srgb, var(--leader-accent) 55%, transparent);
        color: color-mix(in srgb, var(--leader-accent) 60%, #0b1f3a);
        font-size: 0.78rem; font-weight: 700;
    }
    .leader-step .muted { color: var(--cw-muted, #5d6b7e); font-size: 0.9rem; margin: 0.35rem 0 0.7rem 0; }

    .leader-case-row { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
    .leader-case-row select {
        background: #ffffff;
        border: 1px solid rgba(16, 38, 72, 0.198);
        border-radius: 6px;
        color: #0b1f3a;
        padding: 0.5rem 0.7rem;
        font-size: 0.9rem;
        min-width: 280px;
        flex: 1 1 320px;
    }
    .leader-case-row select:focus {
        outline: none;
        border-color: var(--leader-accent);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--leader-accent) 25%, transparent);
    }
    .leader-secondary {
        background: transparent;
        color: #344054;
        border: 1px solid rgba(16, 38, 72, 0.198);
        border-radius: 6px;
        padding: 0.45rem 0.85rem;
        font-size: 0.85rem;
        cursor: pointer;
    }
    .leader-secondary:hover { background: rgba(16, 38, 72, 0.035); color: #0b1f3a; }

    .leader-empty { margin-top: 0.6rem; }

    .leader-case-card {
        margin-top: 0.8rem;
        background: #f6f7f9;
        border: 1px solid rgba(16, 38, 72, 0.112);
        border-radius: 8px;
        padding: 0.8rem 0.95rem;
    }
    .leader-case-num {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        color: color-mix(in srgb, var(--leader-accent) 60%, #0b1f3a);
        font-weight: 700;
        font-size: 0.95rem;
        margin-bottom: 0.45rem;
    }
    .leader-case-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.4rem 0.85rem;
        font-size: 0.85rem;
        color: #344054;
    }
    @@media (max-width: 820px) { .leader-case-grid { grid-template-columns: 1fr; } }
    .leader-case-grid .span-2 { grid-column: span 2; }
    @@media (max-width: 820px) { .leader-case-grid .span-2 { grid-column: span 1; } }
    .leader-case-grid .k {
        display: inline-block;
        min-width: 110px;
        color: var(--cw-muted, #5d6b7e);
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.66rem;
        letter-spacing: 0.08em;
        margin-right: 0.5rem;
    }

    #leader-process-btn {
        background: var(--cw-primary);
        color: #fff;
        border: none;
        border-radius: 999px;
        padding: 0.55rem 1.1rem;
        font-size: 0.9rem;
        font-weight: 700;
        cursor: pointer;
        margin-top: 0.35rem;
    }
    #leader-process-btn:hover:not(:disabled) { filter: brightness(1.08); transform: translateY(-1px); }
    #leader-process-btn:disabled { opacity: 0.5; cursor: not-allowed; }

    .leader-status {
        margin-top: 0.6rem; font-size: 0.88rem;
        color: #344054;
    }
    .leader-status.error { color: #c11818; }
    .leader-status .spinner {
        display: inline-block; width: 12px; height: 12px;
        border: 2px solid rgba(16, 38, 72, 0.25); border-top-color: #0b1f3a;
        border-radius: 50%; margin-right: 6px; vertical-align: middle;
        animation: leader-spin 0.7s linear infinite;
    }
    @@keyframes leader-spin { to { transform: rotate(360deg); } }

    /* ── Floor dashboard ─────────────────────────────────────────────── */
    .tl-asat {
        margin-left: auto;
        font-size: 0.72rem;
        color: var(--cw-muted, #5d6b7e);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 600;
        text-align: right;
    }
    .leader-step .tl-asat-line { margin: 0.2rem 0 0 0; font-size: 0.82rem; }
    .tl-section { margin-top: 0.95rem; }
    .tl-section h4 {
        margin: 0 0 0.45rem 0;
        color: #0e6e5a;
        font-size: 0.74rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }
    .tl-focus {
        margin-top: 0.6rem;
        background: color-mix(in srgb, var(--leader-accent) 10%, #f6f7f9);
        border: 1px solid color-mix(in srgb, var(--leader-accent) 40%, transparent);
        border-radius: 10px;
        padding: 0.8rem 0.95rem;
    }
    .tl-focus-head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin-bottom: 0.45rem; }
    .tl-focus-label {
        font-size: 0.66rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
        color: color-mix(in srgb, var(--leader-accent) 60%, #0b1f3a);
    }
    .tl-focus-title { color: #0b1f3a; font-weight: 700; font-size: 0.95rem; }
    .tl-focus-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem 1rem; font-size: 0.86rem; color: #1d2939; }
    .tl-focus-grid .span-2 { grid-column: span 2; }
    @@media (max-width: 820px) {
        .tl-focus-grid { grid-template-columns: 1fr; }
        .tl-focus-grid .span-2 { grid-column: span 1; }
    }
    .tl-focus-grid .k {
        display: block;
        color: var(--cw-muted, #5d6b7e); font-weight: 700;
        text-transform: uppercase; font-size: 0.64rem; letter-spacing: 0.08em;
        margin-bottom: 0.1rem;
    }
    .tl-facts { margin: 0.2rem 0 0 1.05rem; padding: 0; font-size: 0.82rem; color: #344054; line-height: 1.45; }

    .tl-tiles { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.55rem; }
    @@media (max-width: 900px) { .tl-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    .tl-tile {
        background: #f6f7f9;
        border: 1px solid rgba(16, 38, 72, 0.124);
        border-radius: 10px;
        padding: 0.6rem 0.75rem;
    }
    .tl-tile.hot {
        border-color: color-mix(in srgb, var(--leader-accent) 60%, transparent);
        background: color-mix(in srgb, var(--leader-accent) 12%, #f6f7f9);
    }
    .tl-tile-count { display: block; font-size: 1.55rem; font-weight: 700; color: #0b1f3a; line-height: 1.1; }
    .tl-tile-stage { display: block; font-size: 0.74rem; font-weight: 700; color: #0e6e5a; margin-top: 0.15rem; }
    .tl-tile-hint { display: block; font-size: 0.7rem; color: var(--cw-muted, #5d6b7e); margin-top: 0.1rem; }

    .tl-table-wrap { overflow-x: auto; }
    .tl-table { width: 100%; border-collapse: collapse; font-size: 0.82rem; color: #1d2939; }
    .tl-table th {
        text-align: left;
        font-size: 0.64rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
        color: var(--cw-muted, #5d6b7e);
        padding: 0.35rem 0.5rem;
        border-bottom: 1px solid rgba(16, 38, 72, 0.155);
    }
    .tl-table td {
        padding: 0.45rem 0.5rem;
        border-bottom: 1px solid rgba(16, 38, 72, 0.08);
        vertical-align: top;
        line-height: 1.4;
    }
    .tl-table tr.is-focus td { background: color-mix(in srgb, var(--leader-accent) 10%, transparent); }
    .tl-table .tl-case { white-space: nowrap; }
    .tl-table .tl-case small { display: block; color: var(--cw-muted, #5d6b7e); }
    .tl-note { margin: 0.45rem 0 0 0 !important; font-size: 0.8rem !important; }

    .tl-badge {
        display: inline-block;
        padding: 0.05rem 0.5rem;
        border-radius: 999px;
        font-size: 0.66rem; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.06em;
        border: 1px solid rgba(16, 38, 72, 0.24);
        color: #1d2939;
        background: rgba(148, 163, 184, 0.12);
        white-space: nowrap;
        margin-right: 0.35rem;
    }
    .tl-badge.due, .tl-badge.urgent { color: #c11818; border-color: rgba(239, 68, 68, 0.45); background: rgba(239, 68, 68, 0.14); }
    .tl-badge.running, .tl-badge.high { color: #954f12; border-color: rgba(245, 158, 11, 0.45); background: rgba(245, 158, 11, 0.14); }
    .tl-badge.paused { color: #623fe7; border-color: rgba(139, 92, 246, 0.45); background: rgba(139, 92, 246, 0.14); }
    .tl-badge.ok { color: #0f7032; border-color: rgba(34, 197, 94, 0.45); background: rgba(34, 197, 94, 0.14); }
    .tl-badge.watch { color: #0e6e5b; border-color: rgba(20, 184, 166, 0.45); background: rgba(20, 184, 166, 0.12); }

    .tl-escalations, .tl-list { list-style: none; margin: 0; padding: 0; }
    .tl-escalations li, .tl-list li {
        background: #f6f7f9;
        border: 1px solid rgba(16, 38, 72, 0.099);
        border-radius: 8px;
        padding: 0.5rem 0.7rem;
        margin-bottom: 0.4rem;
        font-size: 0.84rem;
        line-height: 1.45;
        color: #1d2939;
    }
    .tl-escalations li.is-focus, .tl-list li.is-focus {
        border-color: color-mix(in srgb, var(--leader-accent) 55%, transparent);
        background: color-mix(in srgb, var(--leader-accent) 9%, #f6f7f9);
    }
    .tl-escalations .tl-esc-meta, .tl-list .tl-meta { display: block; font-size: 0.76rem; color: var(--cw-muted, #5d6b7e); margin-top: 0.15rem; }
    .tl-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1rem; }
    @@media (max-width: 820px) { .tl-grid-2 { grid-template-columns: 1fr; } }
    .tl-priorities { margin: 0 0 0 1.2rem; padding: 0; font-size: 0.86rem; color: #1d2939; line-height: 1.5; }
    .tl-priorities li { margin-bottom: 0.3rem; }
    .tl-priorities li::marker { color: color-mix(in srgb, var(--leader-accent) 60%, #0b1f3a); font-weight: 700; }

    /* ── Group Chat panel ─────────────────────────────────────────────── */
    .groupchat-panel { --leader-accent: #14b8a6; }

    .gc-roster {
        display: flex; flex-wrap: wrap; gap: 0.4rem;
        margin: 0.6rem 0 0.8rem 0;
    }
    .gc-roster .gc-chip {
        font-size: 0.78rem;
        background: rgba(20, 184, 166, 0.10);
        border: 1px solid rgba(20, 184, 166, 0.35);
        color: #1d2939;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
    }
    .gc-roster .gc-chip.leader {
        background: rgba(20, 184, 166, 0.25);
        border-color: rgba(20, 184, 166, 0.6);
        font-weight: 700;
    }

    #gc-start-btn {
        background: var(--cw-primary);
        color: #fff;
        border: none;
        border-radius: 999px;
        padding: 0.55rem 1.1rem;
        font-size: 0.9rem;
        font-weight: 700;
        cursor: pointer;
        margin-top: 0.35rem;
    }
    #gc-start-btn:hover:not(:disabled) { filter: brightness(1.08); transform: translateY(-1px); }
    #gc-start-btn:disabled { opacity: 0.5; cursor: not-allowed; }

    .gc-transcript {
        margin-top: 0.35rem;
        max-height: 560px;
        overflow: auto;
        padding-right: 0.3rem;
        display: flex; flex-direction: column; gap: 0.55rem;
    }
