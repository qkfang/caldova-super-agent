@code {
    private IReadOnlyList<FactSheet> _sheets = Array.Empty<FactSheet>();

    protected override void OnInitialized()
    {
        // The Overview renders straight from the sample fact sheets the agent reads.
        var dir = Path.Combine(Env.WebRootPath ?? "wwwroot", "investments", "samples");
        var list = new List<FactSheet>();
        foreach (var file in InvestmentsApi.FactSheetFiles)
        {
            var path = Path.Combine(dir, file);
            if (!File.Exists(path)) continue;
            try
            {
                list.Add(InvestmentsMcpTools.ParseFactSheet(InvestmentsMcpTools.SamplesUrlPrefix + file, File.ReadAllText(path)));
            }
            catch (IOException)
            {
                // Skip a sample that can't be read; the rest of the menu still renders.
            }
        }
        _sheets = list;
    }

    private static string IcrText(FactSheet fs) =>
        fs.InvestmentFeePercent is decimal icr ? InvestmentsMcpTools.FormatPercent(icr) : "n/a";

    private static string ReturnText(FactSheet fs) =>
        fs.Returns?.FiveYearPercentPa is decimal r ? r.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) + "%" : "n/a";
}
