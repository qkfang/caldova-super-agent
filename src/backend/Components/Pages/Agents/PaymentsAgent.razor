@page "/agents/payments"

<PageTitle>Payments Agent — Wealth Team in a Day</PageTitle>

<div class="agent-header" style="--accent: #a855f7">
    <a class="back-link" href="/"><span aria-hidden="true">←</span> Back to the operations office</a>
    <div class="agent-header-row">
        <div class="agent-header-icon">💳</div>
        <div>
            <div class="agent-header-dept">Payments</div>
            <h1>Payments Agent</h1>
            <div class="agent-header-persona">Penny — Payments Officer</div>
            <p class="tagline">Gets the tax right, then waits for the human approval.</p>
        </div>
    </div>
</div>

<div class="agent-tab-scope" style="--accent: #a855f7">
    <section class="panel payments-panel" style="--accent: #a855f7">
        <div id="payments-deeplink" class="payments-deeplink" hidden></div>

        <!-- Step 1 — pick a case -->
        <div class="payments-step" data-step="1">
            <div class="payments-step-head">
                <span class="payments-step-num">1</span>
                <h3>Pick a case</h3>
            </div>
            <div class="payments-case-picker">
                <select id="payments-case-select" class="payments-select" aria-label="Member Case">
                    <option value="">— Loading cases —</option>
                </select>
                <button id="payments-refresh-btn" type="button" class="payments-refresh" title="Reload cases">↻</button>
            </div>
            <div id="payments-case-empty" class="payments-status" hidden>
                No cases in memory yet. Open one with the <a href="/agents/onboarding">Onboarding Agent</a> first.
            </div>
            <div id="payments-case-summary" class="payments-summary" hidden>
                <div class="payments-summary-grid">
                    <div><span class="k">Case</span><span id="payments-case-num"></span></div>
                    <div><span class="k">Member</span><span id="payments-case-member"></span></div>
                    <div><span class="k">Product</span><span id="payments-case-product"></span></div>
                    <div><span class="k">Request</span><span id="payments-case-type"></span></div>
                    <div><span class="k">Received</span><span id="payments-case-received"></span></div>
                    <div><span class="k">Adviser</span><span id="payments-case-adviser"></span></div>
                    <div><span class="k">Amount</span><span id="payments-case-amount"></span></div>
                    <div><span class="k">Priority</span><span id="payments-case-priority"></span></div>
                    <div class="span-2"><span class="k">Summary</span><span id="payments-case-summary-text"></span></div>
                </div>
            </div>
        </div>

        <!-- Step 2 — payment inputs -->
        <div class="payments-step" data-step="2" id="payments-inputs-step" hidden>
            <div class="payments-step-head">
                <span class="payments-step-num">2</span>
                <h3>Confirm payment inputs</h3>
            </div>
            <p class="muted">Defaults come from the case and the eligibility decision — edit any value.</p>
            <div id="payments-inputs-hint" class="payments-hint" hidden></div>
            <form id="payments-inputs-form" class="payments-form" autocomplete="off">
                <fieldset>
                    <legend>Payment</legend>
                    <div class="payments-grid">
                        <label>Payment type<select name="paymentType"></select></label>
                        <label>Gross amount (AUD)<input type="number" name="grossAmount" min="0" step="0.01" /></label>
                        <label data-field="requested">Amount requested (AUD)<input type="number" name="requestedAmount" min="0" step="0.01" /></label>
                        <label data-field="commencement">Pension commencement amount (AUD)<input type="number" name="commencementAmount" min="0" step="0.01" /></label>
                        <label class="span-2">Payment date<input type="text" name="paymentDate" /></label>
                    </div>
                </fieldset>
                <fieldset>
                    <legend>Tax</legend>
                    <div class="payments-grid">
                        <label data-field="tax">Tax-free component (%)<input type="number" name="taxFreePercent" min="0" max="100" step="0.01" /></label>
                        <label>Member age<input type="number" name="memberAge" min="0" max="120" step="1" /></label>
                        <label class="span-2">Tax status<select name="taxStatus"></select></label>
                    </div>
                </fieldset>
                <fieldset id="payments-payees-fieldset">
                    <legend>Payee(s) — bank details masked</legend>
                    <div class="payments-payee-head" aria-hidden="true">
                        <span>Name on the account</span><span>BSB</span><span>Account</span><span>Share %</span>
                    </div>
                    <div id="payments-payee-rows"></div>
                    <div id="payments-payees-onfile" class="payments-onfile"></div>
                </fieldset>
                <div id="payments-no-payee" class="payments-no-payee" hidden>
                    No outbound payee — the money is coming into the member's own Caldova account.
                </div>
                <fieldset>
                    <legend>Case approval — from Benefits &amp; Eligibility</legend>
                    <div class="payments-grid">
                        <label>Decision<select name="caseApprovalStatus"></select></label>
                        <label>Approved amount (AUD)<input type="number" name="approvedAmount" min="0" step="0.01" /></label>
                    </div>
                    <div id="payments-case-decision" class="payments-decision"></div>
                </fieldset>
            </form>
        </div>

        <!-- Step 3 — engage the agent -->
        <div class="payments-step" data-step="3" id="payments-process-step" hidden>
            <div class="payments-step-head">
                <span class="payments-step-num">3</span>
                <h3>Engage the Payments Agent</h3>
            </div>
            <button id="payments-process-btn" type="button">Process with Payments Agent</button>
            <div id="payments-process-status" class="payments-status" hidden></div>

            <div class="engage-tabs-scope" data-engage-role="payments">
                <div class="engage-tabs" role="tablist">
                    <button type="button" class="engage-tab-btn active" data-engage-tab="narrative">Agent Narrative</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="reference">Reference</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="prompt">Agent Prompt &amp; Tools</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="input">Agent Input</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="output">Raw Output</button>
                </div>

                <div class="engage-tab-panel active" data-engage-tab="narrative">
                    <div class="engage-info-block">
                        <h4>Agent narrative (streamed)</h4>
                        <div class="agent-md engage-narrative-body"><div class="engage-empty">Engage the agent to see the streamed narrative.</div></div>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="reference">
                    <div class="engage-info-block">
                        <h4>Reference documents cited by the agent</h4>
                        <div class="engage-references-body"><div class="engage-empty">Engage the agent to see the reference documents cited in its response.</div></div>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="prompt">
                    <div class="engage-info-block">
                        <h4>Agent metadata</h4>
                        <div class="engage-info-meta engage-meta"></div>
                    </div>
                    <div class="engage-info-block">
                        <h4>System prompt</h4>
                        <pre class="engage-pre engage-prompt-body">Loading…</pre>
                    </div>
                    <div class="engage-info-block">
                        <h4>Tools available</h4>
                        <ul class="engage-tools-list"><li class="engage-empty">Loading…</li></ul>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="input">
                    <div class="engage-info-block">
                        <h4>Prompt sent to the agent</h4>
                        <pre class="engage-pre engage-input-body engage-empty">Engage the agent to capture the input that was sent.</pre>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="output">
                    <div class="engage-info-block">
                        <h4>Raw agent output (text, citations and every output item, including the payments_* MCP tool calls)</h4>
                        <div class="json-viewer engage-output-body"><div class="engage-empty">Engage the agent to see the full raw response.</div></div>
                    </div>
                </div>
            </div>

            <div id="payments-result" class="payments-result" hidden>
                <div class="payments-card payments-calc">
                    <div class="payments-card-label" id="payments-calc-title">Payment calculation</div>
                    <div class="payments-calc-scroll">
                        <table class="payments-calc-table">
                            <thead id="payments-calc-head"></thead>
                            <tbody id="payments-calc-body"></tbody>
                        </table>
                    </div>
                    <div class="payments-net" id="payments-net">
                        <span class="k" id="payments-net-label">Net payment</span>
                        <span id="payments-net-amount"></span>
                    </div>
                    <dl class="payments-context" id="payments-context"></dl>
                    <div class="payments-rule" id="payments-calc-rule"></div>
                </div>

                <div class="payments-card">
                    <div class="payments-card-label">Cross-checks</div>
                    <ul id="payments-checks-list" class="payments-checks-list"></ul>
                </div>

                <div class="payments-callout payments-approval" id="payments-approval">
                    <div class="payments-callout-head">
                        <span class="payments-step-num small">!</span>
                        <span class="payments-callout-title">Human approval</span>
                        <span class="payments-pill" id="payments-approval-pill"></span>
                    </div>
                    <ul id="payments-approval-reasons" class="payments-reasons"></ul>
                    <p class="payments-approver" id="payments-approval-approver"></p>
                </div>

                <!-- Outbound payment: Microsoft Teams approval, then release -->
                <div class="payments-callout payments-teams" id="payments-teams" hidden>
                    <div class="payments-callout-head">
                        <span class="payments-step-num small teams">T</span>
                        <span class="payments-callout-title">Microsoft Teams approval</span>
                        <span class="payments-pill" id="payments-teams-pill"></span>
                    </div>
                    <p class="payments-teams-msg" id="payments-teams-msg"></p>
                    <div class="payments-teams-preview" id="payments-teams-preview"></div>
                    <div class="payments-teams-meta">
                        <div><span class="k">Approval id</span> <code id="payments-teams-approvalid"></code></div>
                        <div><span class="k">Approval link</span> <a id="payments-teams-link" href="#" target="_blank" rel="noopener">open</a></div>
                    </div>
                    <div class="payments-actions">
                        <button type="button" id="payments-popup-btn" class="payments-popup">Open approval popup</button>
                        <button type="button" id="payments-release-btn" class="payments-release" disabled>Release payment</button>
                    </div>
                    <div class="payments-release-hint" id="payments-release-hint">Release unlocks once the approval is recorded.</div>
                    <div class="payments-teams-status" id="payments-teams-status" hidden></div>
                </div>

                <!-- Blocked case: nothing can be released -->
                <div class="payments-callout payments-blocked" id="payments-blocked" hidden>
                    <div class="payments-callout-head">
                        <span class="payments-step-num small blocked">✕</span>
                        <span class="payments-callout-title">Release blocked — no funds leave the account</span>
                        <span class="payments-pill status-blocked">Blocked</span>
                    </div>
                    <p id="payments-blocked-text"></p>
                    <p class="payments-blocked-record" id="payments-blocked-record"></p>
                    <div class="payments-actions">
                        <button type="button" id="payments-blocked-release" class="payments-release" disabled>Release payment</button>
                    </div>
                    <div class="payments-release-hint" id="payments-blocked-hint"></div>
                </div>

                <!-- Inbound money: invest on arrival, nothing to release -->
                <div class="payments-callout payments-inbound" id="payments-inbound" hidden>
                    <div class="payments-callout-head">
                        <span class="payments-step-num small inbound">↓</span>
                        <span class="payments-callout-title">No outbound payment — invest on arrival</span>
                        <span class="payments-pill optional">No approval needed</span>
                    </div>
                    <p id="payments-inbound-text"></p>
                </div>

                <div class="payments-card payments-notes">
                    <div class="payments-card-label" id="payments-confirmation-title">Payment confirmation draft</div>
                    <div id="payments-confirmation" class="agent-md"></div>
                </div>
            </div>
        </div>

    </section>
</div>

<!-- Approval popup: the in-page stand-in for the Approve / Reject
     actions on the Microsoft Teams card. Approving resumes the same
     Payments Agent conversation so it can call payments_releasePayment. -->
<div id="payments-approval-modal" class="payments-modal" hidden role="dialog" aria-modal="true" aria-labelledby="payments-modal-title">
    <div class="payments-modal-backdrop" data-modal-dismiss></div>
    <div class="payments-modal-card" role="document">
        <button type="button" class="payments-modal-close" data-modal-dismiss aria-label="Close">×</button>
        <div class="payments-modal-header">
            <span class="payments-modal-badge">!</span>
            <div>
                <h3 id="payments-modal-title">Payment approval required</h3>
                <div class="payments-modal-sub">Caldova Wealth — Payment approval · Microsoft Teams</div>
            </div>
        </div>
        <div class="payments-modal-deeplink" id="payments-modal-deeplink" hidden></div>
        <div class="payments-modal-why">Why approval is needed</div>
        <ul class="payments-modal-reasons" id="payments-modal-reasons"></ul>
        <div class="payments-modal-meta">
            <div><span class="k">Case</span><span id="payments-modal-case"></span></div>
            <div><span class="k">Approval id</span><code id="payments-modal-approval-id"></code></div>
            <div class="span-2"><span class="k">Member</span><span id="payments-modal-member"></span></div>
            <div class="span-2"><span class="k">Payment type</span><span id="payments-modal-type"></span></div>
            <div class="span-2"><span class="k">Payee</span><span id="payments-modal-payee"></span></div>
            <div><span class="k">Gross</span><span id="payments-modal-gross"></span></div>
            <div><span class="k">Tax withheld</span><span id="payments-modal-tax"></span></div>
            <div class="span-2 amount-row"><span class="k">Net payment</span><strong id="payments-modal-net"></strong></div>
        </div>
        <p class="payments-modal-explainer">
            Stands in for <strong>Approve</strong> on the Teams card. Release stays locked until the approval is recorded.
        </p>
        <div class="payments-modal-status" id="payments-modal-status" hidden></div>
        <div class="payments-modal-agent" id="payments-modal-agent" hidden>
            <div class="payments-modal-agent-label">Agent reply after approval</div>
            <div class="agent-md" id="payments-modal-agent-body"></div>
        </div>
        <div class="payments-modal-actions">
            <button type="button" id="payments-modal-reject-btn" class="payments-modal-reject">Reject</button>
            <button type="button" id="payments-modal-cancel-btn" class="payments-modal-cancel" data-modal-dismiss>Close</button>
            <button type="button" id="payments-modal-approve-btn" class="payments-modal-approve">Approve</button>
            <button type="button" id="payments-modal-release-btn" class="payments-modal-release" disabled>Release payment</button>
        </div>
    </div>
</div>

<style>
    .payments-panel, .payments-modal { --pay-accent: #a855f7; --pay-teams: #5b5fc7; }
    .payments-panel [hidden], .payments-modal[hidden], .payments-modal [hidden] { display: none !important; }
    .payments-panel .muted code { background: rgba(168, 85, 247, 0.14); padding: 1px 6px; border-radius: 4px; font-size: 0.85rem; }

    /* ── Steps ────────────────────────────────────────────────── */
    .payments-step {
        border: 1px solid rgba(16, 38, 72, 0.112);
        background: #f9fafb;
        border-radius: 12px;
        padding: 0.95rem 1.1rem 1rem 1.1rem;
        margin-top: 0.9rem;
    }
    .payments-step-head { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.3rem; }
    .payments-step-head h3 { margin: 0; color: #0b1f3a; font-size: 1rem; }
    .payments-step-num {
        display: inline-grid; place-items: center; flex: 0 0 auto;
        width: 1.55rem; height: 1.55rem; border-radius: 50%;
        background: color-mix(in srgb, var(--pay-accent) 22%, #f6f7f9);
        border: 1px solid color-mix(in srgb, var(--pay-accent) 55%, transparent);
        color: color-mix(in srgb, var(--pay-accent) 60%, #0b1f3a); font-size: 0.78rem; font-weight: 700;
    }
    .payments-step-num.small { width: 1.4rem; height: 1.4rem; font-size: 0.7rem; }
    .payments-step-num.teams { background: rgba(91, 95, 199, 0.3); border-color: rgba(129, 133, 230, 0.7); color: #2c51e5; }
    .payments-step-num.blocked { background: rgba(239, 68, 68, 0.2); border-color: rgba(239, 68, 68, 0.6); color: #c11818; }
    .payments-step-num.inbound { background: rgba(14, 165, 233, 0.2); border-color: rgba(14, 165, 233, 0.6); color: #126891; }
    .payments-step .muted { color: var(--cw-muted, #5d6b7e); font-size: 0.9rem; margin: 0.35rem 0 0.7rem 0; }

    .payments-deeplink {
        margin: 0.3rem 0 0.4rem 0; padding: 0.6rem 0.85rem; border-radius: 10px; font-size: 0.88rem;
        background: rgba(91, 95, 199, 0.16); border: 1px solid rgba(129, 133, 230, 0.45); color: #1d2939;
    }
    .payments-deeplink.error { background: rgba(239, 68, 68, 0.12); border-color: rgba(239, 68, 68, 0.4); color: #c11818; }

    .payments-case-picker { display: flex; gap: 0.5rem; align-items: center; }
    .payments-select, .payments-form select, .payments-form input, .payments-payee-row input {
        background: #ffffff;
        border: 1px solid rgba(16, 38, 72, 0.136);
        border-radius: 6px; color: #0b1f3a; font-size: 0.9rem;
        padding: 0.5rem 0.65rem; font-family: inherit;
    }
    .payments-select { flex: 1; min-width: 0; }
    .payments-select:focus, .payments-form select:focus, .payments-form input:focus, .payments-payee-row input:focus {
        outline: none; border-color: var(--pay-accent);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--pay-accent) 25%, transparent);
    }
    .payments-refresh {
        background: transparent; color: #344054;
        border: 1px solid rgba(16, 38, 72, 0.198); border-radius: 6px;
        padding: 0.45rem 0.7rem; font-size: 0.95rem; cursor: pointer;
    }
    .payments-refresh:hover { background: rgba(16, 38, 72, 0.035); color: #0b1f3a; }

    .payments-summary {
        margin-top: 0.7rem; background: #f6f7f9;
        border: 1px solid rgba(16, 38, 72, 0.112); border-radius: 8px; padding: 0.7rem 0.85rem;
    }
    .payments-summary-grid {
        display: grid; grid-template-columns: 1fr 1fr; gap: 0.35rem 0.85rem;
        font-size: 0.85rem; color: #344054;
    }
    .payments-summary-grid .span-2 { grid-column: span 2; }
    .payments-summary-grid .k {
        display: inline-block; min-width: 76px; color: var(--cw-muted, #5d6b7e); font-weight: 600;
        text-transform: uppercase; font-size: 0.66rem; letter-spacing: 0.08em; margin-right: 0.5rem;
    }

    /* ── Inputs ───────────────────────────────────────────────── */
    .payments-hint {
        margin: 0 0 0.7rem 0; padding: 0.55rem 0.8rem; border-radius: 8px; font-size: 0.86rem; line-height: 1.45;
        background: color-mix(in srgb, var(--pay-accent) 10%, #f6f7f9);
        border: 1px solid color-mix(in srgb, var(--pay-accent) 30%, transparent); color: #1d2939;
    }
    .payments-form fieldset {
        border: 1px solid rgba(16, 38, 72, 0.099); border-radius: 10px;
        padding: 0.55rem 0.85rem 0.8rem 0.85rem; margin: 0 0 0.7rem 0;
    }
    .payments-form legend {
        float: none; width: auto; margin: 0; padding: 0 0.35rem;
        font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; color: #8428e4;
    }
    .payments-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem 0.85rem; }
    .payments-grid .span-2 { grid-column: span 2; }
    .payments-form label {
        display: block; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.08em;
        color: var(--cw-muted, #5d6b7e); font-weight: 700;
    }
    .payments-form label input, .payments-form label select {
        display: block; width: 100%; margin-top: 0.3rem; text-transform: none; letter-spacing: normal; font-weight: 400;
    }
    .payments-payee-head, .payments-payee-row {
        display: grid; grid-template-columns: 2.2fr 1fr 1.2fr 0.8fr; gap: 0.5rem; align-items: center;
    }
    .payments-payee-head {
        font-size: 0.64rem; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 700;
        color: var(--cw-muted, #5d6b7e); margin: 0.2rem 0 0.3rem 0;
    }
    .payments-payee-row { margin-bottom: 0.4rem; }
    .payments-payee-row input { width: 100%; min-width: 0; }
    .payments-onfile { margin-top: 0.35rem; font-size: 0.8rem; color: var(--cw-muted, #5d6b7e); line-height: 1.7; }
    .payments-onfile-chip {
        display: inline-block; margin: 0 0.3rem 0.2rem 0; padding: 0.1rem 0.55rem; border-radius: 999px;
        background: #f6f7f9; border: 1px solid rgba(16, 38, 72, 0.136); color: #344054;
    }
    .payments-onfile-chip em { font-style: normal; color: var(--cw-muted, #5d6b7e); margin-left: 0.35rem; }
    .payments-no-payee {
        margin: 0 0 0.7rem 0; padding: 0.55rem 0.8rem; border-radius: 8px; font-size: 0.86rem;
        background: rgba(14, 165, 233, 0.08); border: 1px solid rgba(14, 165, 233, 0.3); color: #126794;
    }
    .payments-decision { margin-top: 0.55rem; font-size: 0.84rem; line-height: 1.5; color: #344054; }
    .payments-decision .muted { display: block; font-size: 0.78rem; margin-top: 0.2rem; }

    /* ── Engage ───────────────────────────────────────────────── */
    #payments-process-btn {
        background: var(--cw-primary); color: #fff; border: none; border-radius: 999px;
        padding: 0.55rem 1.1rem; font-size: 0.9rem; font-weight: 700; cursor: pointer; margin-top: 0.35rem;
    }
    #payments-process-btn:disabled { opacity: 0.55; cursor: not-allowed; }
    #payments-process-btn:hover:not(:disabled) { filter: brightness(1.08); }
    .payments-status { margin-top: 0.6rem; font-size: 0.88rem; color: #344054; }
    .payments-status.error { color: #c11818; }
    .payments-status.warn { color: #954f12; }
    .payments-panel .spinner, .payments-modal .spinner {
        display: inline-block; width: 12px; height: 12px;
        border: 2px solid rgba(16, 38, 72, 0.25); border-top-color: #0b1f3a;
        border-radius: 50%; margin-right: 6px; vertical-align: middle;
        animation: payments-spin 0.7s linear infinite;
    }
    @@keyframes payments-spin { to { transform: rotate(360deg); } }

    /* ── Results ──────────────────────────────────────────────── */
    .payments-result { margin-top: 0.85rem; display: grid; gap: 0.85rem; }
    .payments-card {
        background: #f6f7f9; border: 1px solid rgba(16, 38, 72, 0.112);
        border-radius: 10px; padding: 0.85rem 1rem;
    }
    .payments-card-label {
