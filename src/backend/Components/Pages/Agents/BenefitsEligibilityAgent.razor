@page "/agents/benefits-eligibility"

<PageTitle>Benefits &amp; Eligibility Agent — Wealth Team in a Day</PageTitle>

<div class="agent-header" style="--accent: #6366f1">
    <a class="back-link" href="/"><span aria-hidden="true">←</span> Back to operations office</a>
    <div class="agent-header-row">
        <div class="agent-header-icon">📋</div>
        <div>
            <div class="agent-header-dept">Benefits &amp; Eligibility</div>
            <h1>Benefits &amp; Eligibility Agent</h1>
            <div class="agent-header-persona">Ben — Benefits &amp; Eligibility Assessor</div>
            <p class="tagline">Applies the trust deed, PDS and super law — and cites every rule.</p>
        </div>
    </div>
</div>

<div class="agent-tab-scope" style="--accent: #6366f1">
    <section class="panel assessment-panel" style="--accent: #6366f1">
        <!-- Step 1 — pick a case -->
        <div class="assessment-step" data-step="1">
            <div class="assessment-step-head">
                <span class="assessment-step-num">1</span>
                <h3>Pick a Member Case</h3>
            </div>
            <div class="assessment-picker">
                <label for="assessment-case-select" class="assessment-picker-label">Case number</label>
                <select id="assessment-case-select" class="assessment-select">
                    <option value="">— Loading cases —</option>
                </select>
                <button type="button" id="assessment-refresh-btn" class="assessment-refresh" title="Refresh the case list">↻</button>
            </div>
            <div id="assessment-empty" class="assessment-empty" hidden>
                No cases yet. Open one with the <a href="/agents/onboarding">Onboarding Agent</a> first.
            </div>
        </div>

        <!-- Step 2 — review the case and the rule documents -->
        <div class="assessment-step" data-step="2" id="assessment-case-step" hidden>
            <div class="assessment-step-head">
                <span class="assessment-step-num">2</span>
                <h3>Review the case and the rules being applied</h3>
            </div>
            <div class="assessment-case-card" id="assessment-case-card"></div>

            <div class="assessment-rules-head">
                <span class="assessment-rules-title">Rule documents applied</span>
                <span class="assessment-rules-count" id="assessment-rules-count"></span>
            </div>
            <div class="assessment-rules" id="assessment-rules"></div>
        </div>

        <!-- Step 3 — engage the agent -->
        <div class="assessment-step" data-step="3" id="assessment-process-step" hidden>
            <div class="assessment-step-head">
                <span class="assessment-step-num">3</span>
                <h3>Engage the Benefits &amp; Eligibility Agent</h3>
            </div>
            <button id="assessment-process-btn" type="button">Assess with Benefits &amp; Eligibility Agent</button>
            <div id="assessment-process-status" class="assessment-status" hidden></div>

            <div class="engage-tabs-scope" data-engage-role="benefits-eligibility">
                <div class="engage-tabs" role="tablist">
                    <button type="button" class="engage-tab-btn active" data-engage-tab="narrative">Agent Narrative</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="reference">Reference</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="prompt">Agent Prompt &amp; Tools</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="input">Agent Input</button>
                    <button type="button" class="engage-tab-btn" data-engage-tab="output">Raw Output</button>
                </div>

                <div class="engage-tab-panel active" data-engage-tab="narrative">
                    <div class="engage-info-block">
                        <h4>Agent narrative (streamed)</h4>
                        <div class="agent-md engage-narrative-body"><div class="engage-empty">Engage the agent to see the streamed narrative.</div></div>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="reference">
                    <div class="engage-info-block">
                        <h4>Reference documents cited by the agent</h4>
                        <div class="engage-references-body"><div class="engage-empty">Engage the agent to see the reference documents cited in its response.</div></div>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="prompt">
                    <div class="engage-info-block">
                        <h4>Agent metadata</h4>
                        <div class="engage-info-meta engage-meta"></div>
                    </div>
                    <div class="engage-info-block">
                        <h4>System prompt</h4>
                        <pre class="engage-pre engage-prompt-body">Loading…</pre>
                    </div>
                    <div class="engage-info-block">
                        <h4>Tools available</h4>
                        <ul class="engage-tools-list"><li class="engage-empty">Loading…</li></ul>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="input">
                    <div class="engage-info-block">
                        <h4>Prompt sent to the agent</h4>
                        <pre class="engage-pre engage-input-body engage-empty">Engage the agent to capture the input that was sent.</pre>
                    </div>
                </div>

                <div class="engage-tab-panel" data-engage-tab="output">
                    <div class="engage-info-block">
                        <h4>Raw agent output (text, citations, every output item including tool / function calls)</h4>
                        <div class="json-viewer engage-output-body"><div class="engage-empty">Engage the agent to see the full raw response.</div></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Step 4 — eligibility checklist and recommendation, populated from
             the agent's JSON block (or the deterministic report). -->
        <div class="assessment-step" data-step="4" id="assessment-output-step" hidden>
            <div class="assessment-step-head">
                <span class="assessment-step-num">4</span>
                <h3>Eligibility checklist &amp; recommendation</h3>
            </div>
            <p class="muted">Select a clause reference to see the rule text in step 2.</p>
            <div class="assessment-checklist-card">
                <div class="assessment-checklist-head">
                    <span class="assessment-result-pill" id="assessment-checklist-pill"></span>
                    <span class="assessment-result-title">Eligibility checklist</span>
                    <span class="assessment-source" id="assessment-source"></span>
                </div>
                <div class="assessment-tally" id="assessment-tally"></div>
                <ul class="assessment-checklist" id="assessment-checklist"></ul>
                <div class="assessment-decision">
                    <h4>Why</h4>
                    <p id="assessment-decision-reason"></p>
                    <h4>Outcome</h4>
                    <p id="assessment-decision-outcome"></p>
                    <p class="approval assessment-approval-note">
                        The agent recommends; Ben confirms. Declines, partial approvals, hardship releases, death
                        benefits and pension commencements of $1,000,000 or more also need Team Leader approval.
                    </p>
                </div>
            </div>
        </div>
    </section>
</div>

<style>
    .assessment-panel { --assessment-accent: #6366f1; }
    .assessment-panel a { color: #2c51e5; }

    .assessment-step {
        border: 1px solid rgba(16, 38, 72, 0.112);
        background: #f9fafb;
        border-radius: 12px;
        padding: 0.95rem 1.1rem 1rem 1.1rem;
        margin-top: 0.9rem;
    }
    .assessment-step-head { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.3rem; }
    .assessment-step-head h3 { margin: 0; color: #0b1f3a; font-size: 1rem; }
    .assessment-step-num {
        display: inline-grid; place-items: center;
        width: 1.55rem; height: 1.55rem;
        border-radius: 50%;
        background: color-mix(in srgb, var(--assessment-accent) 22%, #f6f7f9);
        border: 1px solid color-mix(in srgb, var(--assessment-accent) 55%, transparent);
        color: color-mix(in srgb, var(--assessment-accent) 60%, #0b1f3a);
        font-size: 0.78rem; font-weight: 700;
    }
    .assessment-step .muted { color: var(--cw-muted, #5d6b7e); font-size: 0.9rem; margin: 0.35rem 0 0.7rem 0; }

    .assessment-picker { display: flex; align-items: center; gap: 0.55rem; flex-wrap: wrap; }
    .assessment-picker-label {
        font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em;
        color: var(--cw-muted, #5d6b7e); font-weight: 700;
    }
    .assessment-select {
        background: #ffffff;
        border: 1px solid rgba(16, 38, 72, 0.155);
        color: #0b1f3a;
        padding: 0.5rem 0.7rem;
        border-radius: 6px;
        font-size: 0.9rem;
        min-width: 340px;
        max-width: 100%;
        font-family: inherit;
    }
    .assessment-select option { background: #ffffff; color: #0b1f3a; }
    .assessment-select:focus {
        outline: none;
        border-color: var(--assessment-accent);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--assessment-accent) 25%, transparent);
    }
    .assessment-refresh {
        background: transparent;
        color: #344054;
        border: 1px solid rgba(16, 38, 72, 0.198);
        border-radius: 6px;
        padding: 0.35rem 0.6rem;
        font-size: 0.95rem;
        cursor: pointer;
    }
    .assessment-refresh:hover { background: rgba(16, 38, 72, 0.035); color: #0b1f3a; }

    .assessment-empty {
        margin-top: 0.7rem;
        padding: 0.7rem 0.9rem;
        background: rgba(245, 158, 11, 0.08);
        border: 1px solid rgba(245, 158, 11, 0.3);
        border-radius: 8px;
        color: #954f12;
        font-size: 0.88rem;
    }
    .assessment-empty a { color: #954f12; }

    /* Member Case card */
    .assessment-case-card {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.45rem 1.2rem;
        background: #f6f7f9;
        border: 1px solid rgba(16, 38, 72, 0.112);
        border-radius: 8px;
        padding: 0.85rem 1rem;
        font-size: 0.88rem;
        color: #344054;
    }
    @@media (max-width: 820px) { .assessment-case-card { grid-template-columns: 1fr; } }
    .assessment-case-card .row { display: flex; gap: 0.5rem; }
    .assessment-case-card .row.span-2 { grid-column: span 2; }
    @@media (max-width: 820px) { .assessment-case-card .row.span-2 { grid-column: span 1; } }
    .assessment-case-card .k {
        min-width: 120px;
        color: var(--cw-muted, #5d6b7e);
        text-transform: uppercase; font-size: 0.66rem; letter-spacing: 0.08em;
        font-weight: 700;
        padding-top: 0.15rem;
    }
    .assessment-case-card .v { color: #1d2939; }
    .assessment-case-card .v.mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
    .assessment-case-card .prio-pill {
        display: inline-block;
        padding: 0.05rem 0.55rem;
        border-radius: 999px;
        font-size: 0.7rem; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.1em;
        margin-right: 0.35rem;
    }
    .assessment-case-card .prio-pill.urgent   { background: rgba(239, 68, 68, 0.18); color: #c11818; border: 1px solid rgba(239, 68, 68, 0.4); }
    .assessment-case-card .prio-pill.high     { background: rgba(245, 158, 11, 0.18); color: #954f12; border: 1px solid rgba(245, 158, 11, 0.4); }
    .assessment-case-card .prio-pill.standard { background: rgba(34, 197, 94, 0.16); color: #0f7032; border: 1px solid rgba(34, 197, 94, 0.4); }

    /* Rule documents */
    .assessment-rules-head {
        display: flex; align-items: baseline; justify-content: space-between; gap: 0.6rem;
        margin: 1rem 0 0.5rem 0;
    }
    .assessment-rules-title {
        font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em;
        color: var(--cw-muted, #5d6b7e); font-weight: 700;
    }
    .assessment-rules-count { font-size: 0.8rem; color: var(--cw-muted, #5d6b7e); }
    .assessment-rules { display: grid; gap: 0.55rem; }
    .rule-doc {
        background: #f6f7f9;
        border: 1px solid rgba(16, 38, 72, 0.136);
        border-radius: 10px;
        overflow: hidden;
    }
    .rule-doc > summary {
        display: flex; align-items: center; gap: 0.55rem;
        padding: 0.7rem 0.9rem;
        cursor: pointer;
        list-style: none;
        color: #0b1f3a;
    }
    .rule-doc > summary::-webkit-details-marker { display: none; }
    .rule-doc > summary:hover { background: rgba(16, 38, 72, 0.025); }
    .rule-doc[open] > summary { border-bottom: 1px dashed rgba(16, 38, 72, 0.155); }
    .rule-doc .doc-chevron { color: var(--cw-muted, #5d6b7e); transition: transform 0.15s ease; font-size: 0.8rem; }
    .rule-doc[open] .doc-chevron { transform: rotate(90deg); }
    .rule-doc .doc-emoji { font-size: 1.05rem; }
    .rule-doc .doc-title { font-weight: 600; font-size: 0.92rem; flex: 1; }
    .rule-doc .doc-type {
        font-size: 0.66rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
        padding: 0.08rem 0.5rem; border-radius: 999px;
        background: rgba(99, 102, 241, 0.16); color: #2c51e5; border: 1px solid rgba(99, 102, 241, 0.4);
        white-space: nowrap;
    }
    .rule-doc-body { padding: 0.75rem 0.95rem 0.95rem 0.95rem; font-size: 0.86rem; color: #1d2939; }
    .rule-meta {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.25rem 0.75rem;
        margin: 0 0 0.6rem 0;
    }
    .rule-meta .k {
        color: var(--cw-muted, #5d6b7e);
        text-transform: uppercase; font-size: 0.64rem; letter-spacing: 0.08em;
        font-weight: 700; padding-top: 0.15rem;
    }
    .rule-summary {
        font-size: 0.84rem;
        color: #344054;
        margin: 0 0 0.7rem 0;
        font-style: italic;
        border-left: 2px solid rgba(16, 38, 72, 0.24);
        padding: 0.05rem 0 0.05rem 0.6rem;
    }
    .rule-doc h5 {
        margin: 0.75rem 0 0.35rem 0;
        font-size: 0.72rem;
        color: var(--cw-muted, #5d6b7e);
        text-transform: uppercase; letter-spacing: 0.09em;
        font-weight: 700;
    }
    .rule-clauses { list-style: none; margin: 0; padding: 0; }
    .rule-clause {
        padding: 0.5rem 0.6rem;
        border-radius: 7px;
        background: rgba(16, 38, 72, 0.025);
        border: 1px solid rgba(16, 38, 72, 0.087);
        border-left: 3px solid rgba(16, 38, 72, 0.217);
        margin-bottom: 0.38rem;
        scroll-margin-top: 90px;
    }
    .rule-clause.checked { border-left-color: var(--assessment-accent); }
    .rule-clause.cited-pass { border-left-color: #34d399; }
    .rule-clause.cited-fail { border-left-color: #f87171; background: rgba(239, 68, 68, 0.05); }
    .rule-clause.cited-info { border-left-color: #fcd34d; }
    .rule-clause .clause {
        display: inline-block;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.72rem;
        color: #2c51e5;
        background: rgba(99, 102, 241, 0.16);
        padding: 0.05rem 0.45rem;
        border-radius: 4px;
        margin-right: 0.4rem;
    }
    .rule-clause .title { color: #0b1f3a; font-weight: 600; }
    .rule-clause .marker {
        margin-left: 0.4rem;
        font-size: 0.64rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
        color: #3050e5;
    }
    .rule-clause.cited-pass .marker { color: #0f7032; }
    .rule-clause.cited-fail .marker { color: #c11818; }
    .rule-clause.cited-info .marker { color: #954f12; }
    .rule-clause .desc { display: block; color: #344054; font-size: 0.83rem; margin-top: 0.25rem; line-height: 1.5; }
    .rule-clause .ref { display: block; color: var(--cw-muted, #5d6b7e); font-size: 0.74rem; margin-top: 0.2rem; }
    .rule-clause.flash { animation: rule-flash 1.8s ease; }
    @@keyframes rule-flash {
        0%, 35% { box-shadow: 0 0 0 2px rgba(165, 180, 252, 0.85); background: rgba(99, 102, 241, 0.2); }
        100% { box-shadow: 0 0 0 0 rgba(165, 180, 252, 0); }
    }
    .rule-lists { display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem 1rem; }
    @@media (max-width: 820px) { .rule-lists { grid-template-columns: 1fr; } }
    .rule-lists ul { margin: 0; padding-left: 1.05rem; color: #344054; font-size: 0.83rem; }
    .rule-lists li { margin-bottom: 0.2rem; line-height: 1.45; }
    .rule-kb { margin-top: 0.7rem; font-size: 0.76rem; color: var(--cw-muted, #5d6b7e); }

    #assessment-process-btn {
        background: var(--cw-primary);
        color: #fff;
        border: none;
        border-radius: 999px;
        padding: 0.5rem 1rem;
        font-size: 0.88rem;
        font-weight: 700;
        cursor: pointer;
        margin-top: 0.35rem;
    }
    #assessment-process-btn:disabled { opacity: 0.55; cursor: not-allowed; }

    .assessment-status {
        margin-top: 0.6rem; font-size: 0.88rem;
        color: #344054;
    }
    .assessment-status.error { color: #c11818; }
    .assessment-status.warn { color: #954f12; }
    .assessment-status .spinner {
        display: inline-block; width: 12px; height: 12px;
        border: 2px solid rgba(16, 38, 72, 0.25); border-top-color: #0b1f3a;
        border-radius: 50%; margin-right: 6px; vertical-align: middle;
        animation: assessment-spin 0.7s linear infinite;
    }
    @@keyframes assessment-spin { to { transform: rotate(360deg); } }

    /* Eligibility checklist */
    .assessment-checklist-card {
        background: #f6f7f9;
        border: 1px solid rgba(16, 38, 72, 0.136);
        border-radius: 10px;
        padding: 0.95rem 1rem 1rem 1rem;
        font-size: 0.88rem;
        color: #1d2939;
    }
    .assessment-checklist-head { display: flex; align-items: center; gap: 0.55rem; flex-wrap: wrap; margin-bottom: 0.4rem; }
    .assessment-result-title { color: #0b1f3a; font-weight: 700; font-size: 0.92rem; }
    .assessment-result-pill {
        padding: 0.22rem 0.8rem;
        border-radius: 999px;
        font-size: 0.74rem; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.08em;
        background: rgba(165, 180, 252, 0.18);
        color: #2c51e5;
        border: 1px solid rgba(16, 38, 72, 0.24);
    }
    .assessment-result-pill.approve { background: rgba(34, 197, 94, 0.16); color: #0f7032; border-color: rgba(34, 197, 94, 0.4); }
    .assessment-result-pill.partial { background: rgba(245, 158, 11, 0.18); color: #954f12; border-color: rgba(245, 158, 11, 0.4); }
    .assessment-result-pill.decline { background: rgba(239, 68, 68, 0.18); color: #c11818; border-color: rgba(239, 68, 68, 0.4); }
    .assessment-result-pill.info    { background: rgba(110, 193, 255, 0.14); color: #1564a8; border-color: rgba(110, 193, 255, 0.35); }
    .assessment-source {
        margin-left: auto;
        font-size: 0.7rem; color: var(--cw-muted, #5d6b7e);
        border: 1px dashed rgba(16, 38, 72, 0.217);
        border-radius: 999px;
        padding: 0.05rem 0.55rem;
    }
    .assessment-tally { font-size: 0.8rem; color: #344054; margin: 0 0 0.6rem 0; }
    .assessment-tally .pass { color: #0f7032; font-weight: 700; }
    .assessment-tally .fail { color: #c11818; font-weight: 700; }
    .assessment-tally .info { color: #954f12; font-weight: 700; }

    .assessment-checklist { list-style: none; margin: 0; padding: 0; }
    .assessment-checklist li {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.6rem;
        padding: 0.55rem 0.6rem;
        margin-bottom: 0.4rem;
        border-radius: 8px;
        background: rgba(16, 38, 72, 0.025);
        border: 1px solid rgba(16, 38, 72, 0.087);
    }
    .assessment-checklist li.pass { border-left: 3px solid #34d399; }
    .assessment-checklist li.fail { border-left: 3px solid #f87171; background: rgba(239, 68, 68, 0.05); }
    .assessment-checklist li.info { border-left: 3px solid #fcd34d; }
    .assessment-checklist .icon {
        display: inline-grid; place-items: center;
        width: 22px; height: 22px;
        border-radius: 50%;
        font-size: 0.75rem; font-weight: 700;
        margin-top: 0.1rem;
    }
    .assessment-checklist .icon.pass { background: rgba(34, 197, 94, 0.2); color: #0f7032; border: 1px solid rgba(34, 197, 94, 0.5); }
    .assessment-checklist .icon.fail { background: rgba(239, 68, 68, 0.2); color: #c11818; border: 1px solid rgba(239, 68, 68, 0.5); }
    .assessment-checklist .icon.info { background: rgba(245, 158, 11, 0.2); color: #954f12; border: 1px solid rgba(245, 158, 11, 0.5); }
    .assessment-checklist .label {
        color: #0b1f3a; font-weight: 600; font-size: 0.9rem;
        display: flex; align-items: center; gap: 0.45rem;
        flex-wrap: wrap;
    }
    .assessment-checklist .status-text {
        font-size: 0.64rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
        color: var(--cw-muted, #5d6b7e);
    }
    .assessment-checklist .clause-ref {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.7rem;
        color: #2c51e5;
        background: rgba(99, 102, 241, 0.16);
        border: 1px solid rgba(99, 102, 241, 0.35);
        padding: 0.05rem 0.4rem;
        border-radius: 4px;
        font-weight: 500;
        cursor: pointer;
    }
    .assessment-checklist .clause-ref:hover { background: rgba(99, 102, 241, 0.3); color: #0b1f3a; }
    .assessment-checklist .finding {
        color: #344054;
        font-size: 0.83rem;
        line-height: 1.5;
        margin-top: 0.2rem;
    }

    .assessment-decision {
        margin-top: 0.8rem;
        padding-top: 0.6rem;
        border-top: 1px dashed rgba(16, 38, 72, 0.155);
    }
    .assessment-decision h4 {
        margin: 0.4rem 0 0.2rem 0;
        font-size: 0.78rem;
        color: var(--cw-muted, #5d6b7e);
        text-transform: uppercase; letter-spacing: 0.09em;
        font-weight: 700;
    }
    .assessment-decision p {
        margin: 0;
        font-size: 0.86rem;
        line-height: 1.55;
        color: #1d2939;
    }
    .assessment-decision .assessment-approval-note { margin-top: 0.8rem; font-size: 0.82rem; }
</style>

