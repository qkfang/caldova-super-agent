@inherits LayoutComponentBase

<div class="site">
    <header class="site-header">
        <NavMenu />
    </header>

    <main class="site-main">
        <article class="content site-container">
            @Body
        </article>
    </main>

    <footer class="site-footer">
        <div class="site-container footer-slim">
            <span>Caldova Wealth is fictional — members, cases and figures are illustrative.</span>
            <span>Wealth Team in a Day · AI agents built on Microsoft Foundry</span>
        </div>
    </footer>
</div>
@* ── Full-page toggle: hides the site header and footer for a wider stage. ── *@
<button id="full-page-toggle"
        class="full-page-toggle"
        type="button"
        title="Full page view (hide header and footer)"
        aria-label="Hide header and footer for full page view"
        aria-pressed="false"
        onclick="(function(b){var h=document.body.classList.toggle('left-nav-hidden');b.setAttribute('aria-pressed',h?'true':'false');b.setAttribute('aria-label',h?'Show header and footer':'Hide header and footer for full page view');b.setAttribute('title',h?'Exit full page view':'Full page view (hide header and footer)');})(this)">
    <svg class="icon-expand" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="4 9 4 4 9 4"></polyline>
        <polyline points="20 9 20 4 15 4"></polyline>
        <polyline points="4 15 4 20 9 20"></polyline>
        <polyline points="20 15 20 20 15 20"></polyline>
    </svg>
    <svg class="icon-collapse" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="9 4 4 4 4 9"></polyline>
        <polyline points="15 4 20 4 20 9"></polyline>
        <polyline points="9 20 4 20 4 15"></polyline>
        <polyline points="15 20 20 20 20 15"></polyline>
    </svg>
</button>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
